{
  "expo": {
    "name": "EasyWealthGuide",
    "slug": "MyReactNativeApp",
    "description": "Your path to financial clarity - track loans, assets, and build wealth with confidence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#667eea",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#667eea"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.easywealthguide.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow EasyWealthGuide to access camera to capture receipts and documents",
        "NSPhotoLibraryUsageDescription": "Allow EasyWealthGuide to access photo library to save and manage financial documents"
      }
    },
    "android": {
      "package": "com.easywealthguide.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#667eea"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE", 
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "expo-notifications",
      "expo-navigation-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "7b1a4fe2-493e-4515-9480-82e7a61ce715"
      }
    },
    "owner": "dontayeb",
    "scheme": "easywealthguide"
  }
}
